# --- Your app ---
APP_NAME=StudyApp
APP_DESCRIPTION=AI study app that turns notes into flashcards and quizzes
APP_LANDING_URL=https://yourapp.com/download       # smart link that routes to App Store / Play
NICHE_HASHTAGS=studytok,studywithme,studytips,examseason,studymotivation
COMPETITOR_ACCOUNTS=                               # comma-separated handles

# --- Infra ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL_BULK=claude-sonnet-5-5                   # scripts/revisions
LLM_MODEL_JUDGE=claude-opus-5-5                    # research, critique, analytics

# --- Voiceover (optional; without it videos are text-only with no captions) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Research (optional; else use `research --csv file.csv`) ---
APIFY_TOKEN=

# --- Posting ---
IG_USER_ID=
IG_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY                           # PUBLIC_TO_EVERYONE only after TikTok audit

# --- Attribution: JSON {"<utm_content>": {"clicks": n, "installs": n}} exported from Branch/AppsFlyer/ASC ---
INSTALLS_FILE=

# --- Ops ---
ALERT_WEBHOOK_URL=                                 # Slack/Discord incoming webhook
VIDEOS_PER_RUN=3
QUALITY_THRESHOLD=7
MAX_CRITIQUE_LOOPS=2
AUTO_APPROVE=false
POST_SLOTS_UTC=15:00,20:00
DAILY_POST_CAP=2
DAILY_BUDGET_USD=10
