# ---------------------------------------------------------------------------
# Required everywhere (worker, GitHub Actions, dashboard)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Encrypts API keys saved from the dashboard. Generate: openssl rand -base64 32
# Must be identical on the dashboard and in GitHub Actions. Changing it makes saved keys unreadable.
SETTINGS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Dashboard only
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=
# Optional; signs login cookies (defaults to a value derived from the password).
SESSION_SECRET=
# Set to true (with no SUPABASE_URL) to explore the UI with sample data.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Everything else is set in the dashboard → Settings and stored encrypted.
# Env vars with the same names still work as fallbacks (e.g. for the CLI), e.g.:
# ANTHROPIC_API_KEY=  ELEVENLABS_API_KEY=  APIFY_TOKEN=  IG_USER_ID=  IG_ACCESS_TOKEN=
# TIKTOK_ACCESS_TOKEN=  APP_NAME=  APP_DESCRIPTION=  APP_LANDING_URL=  ...
# CHROME_PATH=   # only if Remotion can't download its own Chrome
